# ---------------------------------------------------------------------------
# Inventory source
# ---------------------------------------------------------------------------

# When "true", src/lib/inventory.ts serves vehicles from the hand-written
# src/lib/demo-inventory.ts module instead of querying Postgres. This lets
# the site run with zero infrastructure (no DB, no Frazer feed) so it can be
# demoed or developed against before the real feed is live. Set to "false"
# (or unset) once DATABASE_URL points at a real, populated database.
DEMO_MODE="true"

DATABASE_URL="postgres://user:pass@host/db"
BLOB_READ_WRITE_TOKEN=""
FRAZER_FEED_URL=""
CRON_SECRET=""
ADMIN_PASSWORD=""

# IANA timezone used to render sync-run timestamps on the admin page. Vercel's
# servers run in UTC; this is the dealer's local timezone. Defaults to
# America/New_York when unset.
#
# NOTE: this is separate from DEALER.timezone in src/lib/dealer.ts, which is
# what decides the "open today" hours shown to shoppers. Set both.
DEALER_TIMEZONE="America/New_York"

# ---------------------------------------------------------------------------
# Public site
# ---------------------------------------------------------------------------

# The site's own canonical origin, with protocol and no trailing slash. Used
# for canonical tags, Open Graph URLs, JSON-LD @id values and the sitemap, so
# it must be the real production domain or search engines index the wrong
# host. Falls back to a reserved .example domain, which the production build
# guard rejects.
NEXT_PUBLIC_SITE_URL="https://www.example-dealer.com"

# ---------------------------------------------------------------------------
# Placeholder guard (see src/lib/dealer.ts)
# ---------------------------------------------------------------------------

# src/lib/dealer.ts ships fictional contact details -- a 555 phone number, a
# reserved .example domain, an invented address -- until the client answers
# docs/client-intake-questions.md §1. Shipping those to a live site would
# point real buyers at a fake phone number, so a production deploy refuses to
# build while they are still in place.
#
# The guard fires when VERCEL_ENV=production. On a non-Vercel host, set this
# to "true" in the production environment to get the same protection.
REQUIRE_REAL_DEALER_DATA=""

# Escape hatch: set to "true" to deploy a production build with placeholder
# dealer data anyway (e.g. a staging site on a production-flagged host).
# Do not set this on the real site.
ALLOW_PLACEHOLDER_DEALER=""
