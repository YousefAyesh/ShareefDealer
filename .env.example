# When "true", src/lib/inventory.ts serves vehicles from the hand-written
# src/lib/demo-inventory.ts module instead of querying Postgres. This lets
# the site run with zero infrastructure (no DB, no Frazer feed) so it can be
# demoed or developed against before the real feed is live. Set to "false"
# (or unset) once DATABASE_URL points at a real, populated database.
DEMO_MODE="true"

DATABASE_URL="postgres://user:pass@host/db"
BLOB_READ_WRITE_TOKEN=""
FRAZER_FEED_URL=""
CRON_SECRET=""
ADMIN_PASSWORD=""
# IANA timezone used to render sync-run timestamps on the admin page. Vercel's
# servers run in UTC; this is the dealer's local timezone. Defaults to
# America/New_York when unset.
DEALER_TIMEZONE="America/New_York"
